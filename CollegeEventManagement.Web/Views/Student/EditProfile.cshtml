@model UpdateProfileDto
@{
    ViewData["Title"] = "Edit Profile - CampusEvents";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Profile" class="text-decoration-none">Profile</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-3" style="color: var(--dark-purple);">Edit Student Profile</h4>
                <p class="text-muted small mb-4">Keep your contact and academic department details up to date.</p>

                <form asp-action="EditProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small text-muted">Full Name</label>
                        <input asp-for="FullName" class="form-control form-control-custom" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold small text-muted">Department</label>
                        <input asp-for="Department" class="form-control form-control-custom" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AcademicYear" class="form-label fw-semibold small text-muted">Academic Year</label>
                        <input asp-for="AcademicYear" class="form-control form-control-custom" />
                        <span asp-validation-for="AcademicYear" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-muted">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-custom" placeholder="+1 (555) 000-0000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary-purple">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                        <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
