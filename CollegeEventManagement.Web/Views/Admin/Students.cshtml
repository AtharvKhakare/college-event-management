@model PagedResult<StudentAccountDto>
@{
    ViewData["Title"] = "Manage Students - Admin";
    var search = ViewBag.Search as string;
}

<div class="admin-layout">
    <partial name="_AdminSidebar" />

    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--dark-purple);">Student Accounts</h2>
                <p class="text-muted small mb-0">Overview of registered students and their campus event engagement</p>
            </div>
            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
                <i class="bi bi-people-fill text-primary me-1"></i> @Model.TotalCount Registered Students
            </span>
        </div>

        <!-- Search Bar -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
            <form asp-action="Students" method="get" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" name="search" value="@search" class="form-control form-control-custom border-start-0" placeholder="Search by student name, roll number, department, or email..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-purple flex-grow-1">Search</button>
                    <a asp-action="Students" class="btn btn-outline-secondary rounded-pill" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- Students Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            @if (!Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-person-x fs-1 text-muted mb-2 d-block"></i>
                    <h5>No student accounts found</h5>
                    <p class="small mb-0">Try clearing the search query.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Roll / ID No.</th>
                                <th>Department</th>
                                <th>Academic Year</th>
                                <th>Active Bookings</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="stat-icon-box" style="width: 40px; height: 40px; font-size: 1.2rem;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <strong class="text-dark d-block">@s.FullName</strong>
                                                <span class="text-muted small">@s.Email</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><strong>@(s.StudentId ?? "-")</strong></td>
                                    <td>@(s.Department ?? "Not specified")</td>
                                    <td><span class="badge bg-light text-dark border">@(s.AcademicYear ?? "-")</span></td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-bold">
                                            @s.RegistrationCount Events
                                        </span>
                                    </td>
                                    <td><span class="text-muted small">@s.CreatedAt.ToString("MMM dd, yyyy")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Page @Model.PageNumber of @Model.TotalPages</span>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Students" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-search="@search" class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")">Previous</a>
                            <a asp-action="Students" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-search="@search" class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")">Next</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
