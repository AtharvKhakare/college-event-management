@model PagedResult<RegistrationDto>
@{
    ViewData["Title"] = "Manage Registrations - Admin";
    var events = ViewBag.Events as List<EventDto> ?? new List<EventDto>();
    var filter = ViewBag.Filter as RegistrationFilterDto ?? new RegistrationFilterDto();
}

<div class="admin-layout">
    <partial name="_AdminSidebar" />

    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--dark-purple);">Event Registrations</h2>
                <p class="text-muted small mb-0">Review student bookings, update approval status, and manage attendance</p>
            </div>
            <a asp-action="Reports" class="btn btn-outline-purple">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
            </a>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
            <form asp-action="Registrations" method="get" class="row g-2 align-items-center">
                <!-- Search -->
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" name="search" value="@filter.Search" class="form-control form-control-custom border-start-0" placeholder="Student name, roll no, or event..." />
                    </div>
                </div>

                <!-- Event Filter -->
                <div class="col-md-3">
                    <select name="eventId" class="form-select form-select-custom">
                        <option value="">All Events</option>
                        @foreach (var ev in events)
                        {
                            if (filter.EventId == ev.EventId)
                            {
                                <option value="@ev.EventId" selected>@ev.Title</option>
                            }
                            else
                            {
                                <option value="@ev.EventId">@ev.Title</option>
                            }
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-custom">
                        <option value="">All Statuses</option>
                        @foreach (var st in RegistrationStatus.All)
                        {
                            if (filter.Status == st)
                            {
                                <option value="@st" selected>@st</option>
                            }
                            else
                            {
                                <option value="@st">@st</option>
                            }
                        }
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-purple flex-grow-1">Filter</button>
                    <a asp-action="Registrations" class="btn btn-outline-secondary rounded-pill" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- Registrations Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            @if (!Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-ticket-perforated fs-1 text-muted mb-2 d-block"></i>
                    <h5>No registrations found</h5>
                    <p class="small mb-0">Try clearing the search query or selecting a different event filter.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ticket ID</th>
                                <th>Student</th>
                                <th>Event</th>
                                <th>Booked On</th>
                                <th>Status</th>
                                <th>Attendance</th>
                                <th class="text-end">Update Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.Items)
                            {
                                var statusBadge = reg.Status switch
                                {
                                    RegistrationStatus.Approved => "badge-approved",
                                    RegistrationStatus.Pending => "badge-pending",
                                    RegistrationStatus.Rejected => "badge-rejected",
                                    RegistrationStatus.Cancelled => "badge-cancelled",
                                    _ => "badge-cancelled"
                                };

                                var attendanceBadge = reg.AttendanceStatus switch
                                {
                                    AttendanceStatuses.Present => "badge-present",
                                    AttendanceStatuses.Absent => "badge-absent",
                                    _ => "badge-unmarked"
                                };

                                <tr>
                                    <td><strong class="text-primary">#REG-@reg.RegistrationId.ToString("D5")</strong></td>
                                    <td>
                                        <strong class="d-block text-dark">@reg.StudentName</strong>
                                        <span class="text-muted small">@(reg.StudentId ?? reg.StudentEmail) | @(reg.Department ?? "")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold d-block text-truncate" style="max-width: 180px;" title="@reg.EventTitle">@reg.EventTitle</span>
                                        <span class="text-muted small">@reg.EventDate.ToString("MMM dd")</span>
                                    </td>
                                    <td><span class="text-muted small">@reg.RegistrationDate.ToString("MMM dd, yyyy")</span></td>
                                    <td><span class="badge-status @statusBadge">@reg.Status</span></td>
                                    <td><span class="badge-status @attendanceBadge">@reg.AttendanceStatus</span></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (reg.Status != RegistrationStatus.Approved)
                                            {
                                                <form asp-action="UpdateRegistrationStatus" asp-route-id="@reg.RegistrationId" asp-route-status="@RegistrationStatus.Approved" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success" title="Approve">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>
                                                </form>
                                            }
                                            @if (reg.Status != RegistrationStatus.Rejected)
                                            {
                                                <form asp-action="UpdateRegistrationStatus" asp-route-id="@reg.RegistrationId" asp-route-status="@RegistrationStatus.Rejected" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning" title="Reject">
                                                        <i class="bi bi-slash-circle"></i> Reject
                                                    </button>
                                                </form>
                                            }
                                            @if (reg.Status != RegistrationStatus.Cancelled)
                                            {
                                                <form asp-action="UpdateRegistrationStatus" asp-route-id="@reg.RegistrationId" asp-route-status="@RegistrationStatus.Cancelled" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Cancel">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)</span>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Registrations" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-search="@filter.Search" asp-route-eventId="@filter.EventId" asp-route-status="@filter.Status" class="btn btn-outline-secondary @(!Model.HasPreviousPage ? "disabled" : "")">Previous</a>
                            <a asp-action="Registrations" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-search="@filter.Search" asp-route-eventId="@filter.EventId" asp-route-status="@filter.Status" class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")">Next</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
