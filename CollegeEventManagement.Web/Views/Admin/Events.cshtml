@model PagedResult<EventDto>
@{
    ViewData["Title"] = "Manage Events - CampusEvents";
    var filter = ViewBag.Filter as EventFilterDto ?? new EventFilterDto();
}

<div class="admin-layout">
    <partial name="_AdminSidebar" />

    <div class="admin-content">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--dark-purple);">Manage Events</h2>
                <p class="text-muted small mb-0">Create, edit, publish, and manage all campus activities</p>
            </div>
            <a asp-action="CreateEvent" class="btn btn-primary-purple">
                <i class="bi bi-plus-circle me-1"></i> Create New Event
            </a>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
            <form asp-action="Events" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" name="search" value="@filter.Search" class="form-control form-control-custom border-start-0" placeholder="Search by title, organizer, or venue..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="category" class="form-select form-select-custom">
                        <option value="">All Categories</option>
                        @foreach (var cat in EventCategories.All)
                        {
                            if (filter.Category == cat)
                            {
                                <option value="@cat" selected>@cat</option>
                            }
                            else
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-purple flex-grow-1">Filter</button>
                    <a asp-action="Events" class="btn btn-outline-secondary rounded-pill" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- Events Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            @if (!Model.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-calendar-x fs-1 mb-2 d-block"></i>
                    <h5>No events found</h5>
                    <p class="small mb-3">Try adjusting your filters or create a new event.</p>
                    <a asp-action="CreateEvent" class="btn btn-primary-purple btn-sm">Create Event</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Date &amp; Time</th>
                                <th>Venue</th>
                                <th>Registrations</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@ev.ImageUrl" alt="@ev.Title" class="rounded-3 shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/events/default-event.jpg';" />
                                            <div>
                                                <strong class="d-block text-dark">@ev.Title</strong>
                                                <span class="text-muted small">Org: @ev.OrganizerName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@ev.Category</span>
                                    </td>
                                    <td>
                                        <div>@ev.EventDate.ToString("MMM dd, yyyy")</div>
                                        <span class="text-muted small">@ev.StartTime.ToString(@"hh\:mm") - @ev.EndTime.ToString(@"hh\:mm")</span>
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 140px;" title="@ev.Venue">
                                            @ev.Venue
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@ev.RegisteredCount / @ev.Capacity</span>
                                        <div class="capacity-progress mt-1" style="width: 80px;">
                                            <div class="capacity-progress-bar" style="width: @(ev.Capacity > 0 ? (int)((double)ev.RegisteredCount / ev.Capacity * 100) : 0)%;"></div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (ev.IsPublished)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-muted rounded-pill px-2 py-1">Draft</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-outline-secondary" title="View attendees">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteModal-@ev.EventId">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@ev.EventId" tabindex="-1" aria-labelledby="delModalLabel-@ev.EventId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                <div class="modal-content rounded-4 border-0">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold" id="delModalLabel-@ev.EventId">Delete Event</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <p class="mb-1">Are you sure you want to permanently delete:</p>
                                                        <strong class="text-danger d-block mb-2">"@ev.Title"?</strong>
                                                        <p class="small text-muted mb-0">This will also delete all associated registrations. This action cannot be undone.</p>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-secondary rounded-pill btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill btn-sm">Delete Permanently</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
