@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 my-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 600px;">
        <div class="stat-icon-box mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2.5rem; background: #FEE2E2; color: #DC2626;">
            <i class="bi bi-shield-slash-fill"></i>
        </div>
        <h2 class="fw-bold mb-3" style="color: var(--dark-purple);">Access Denied</h2>
        <p class="text-muted mb-4">
            You do not have the required permissions or role to view this administrative resource. If you believe this is an error, please sign in with an authorized account.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-purple">
                <i class="bi bi-house me-1"></i> Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-purple">
                <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
            </a>
        </div>
    </div>
</div>
