@model List<EventDto>
@{
    ViewData["Title"] = "Discover. Participate. Celebrate. - College Events";
}

<!-- Hero Section -->
<section class="hero-gradient mb-5">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center py-4">
            <div class="col-lg-8 mx-auto text-center">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm" style="color: var(--primary-purple) !important;">
                    <i class="bi bi-stars text-warning me-1"></i> Official Campus Activity Portal
                </span>
                <h1 class="hero-title">Discover. Participate. Celebrate.</h1>
                <p class="hero-subtitle mx-auto">
                    Explore college events, register for your favorite activities, and make your college experience unforgettable.
                </p>

                <!-- Search & Filter Bar -->
                <div class="card border-0 shadow-lg p-2 rounded-pill bg-white text-start mb-4 mx-auto" style="max-width: 680px;">
                    <form asp-controller="Events" asp-action="Index" method="get" class="d-flex flex-column flex-sm-row align-items-center gap-2 p-1">
                        <div class="input-group border-0 flex-grow-1 ps-2">
                            <span class="input-group-text bg-transparent border-0 text-muted">
                                <i class="bi bi-search fs-5 text-primary"></i>
                            </span>
                            <input type="text" name="search" class="form-control border-0 shadow-none ps-0" placeholder="Search hackathons, sports, fest...">
                        </div>
                        <select name="category" class="form-select border-0 shadow-none text-muted" style="max-width: 170px;">
                            <option value="">All Categories</option>
                            @foreach (var cat in EventCategories.All)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary-purple px-4 py-2 flex-shrink-0">
                            Find Events
                        </button>
                    </form>
                </div>

                <!-- Category Chips -->
                <div class="d-flex flex-wrap justify-content-center gap-2 pt-2">
                    <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="bi bi-grid-fill me-1"></i> All
                    </a>
                    @foreach (var cat in EventCategories.All)
                    {
                        <a asp-controller="Events" asp-action="Index" asp-route-category="@cat" class="btn btn-sm btn-outline-light rounded-pill px-3">
                            @cat
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Metrics & Quick Highlights Row -->
<div class="container mb-5">
    <div class="row g-4 text-center">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <i class="bi bi-calendar-check-fill fs-1 mb-2" style="color: var(--primary-purple);"></i>
                <h3 class="fw-bold mb-1" style="color: var(--dark-purple);">10+</h3>
                <span class="text-muted small fw-medium">Active Events</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <i class="bi bi-people-fill fs-1 mb-2" style="color: #059669;"></i>
                <h3 class="fw-bold mb-1" style="color: var(--dark-purple);">500+</h3>
                <span class="text-muted small fw-medium">Students Enrolled</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <i class="bi bi-trophy-fill fs-1 mb-2" style="color: #D97706;"></i>
                <h3 class="fw-bold mb-1" style="color: var(--dark-purple);">5</h3>
                <span class="text-muted small fw-medium">Event Categories</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <i class="bi bi-qr-code fs-1 mb-2" style="color: #2563EB;"></i>
                <h3 class="fw-bold mb-1" style="color: var(--dark-purple);">100%</h3>
                <span class="text-muted small fw-medium">Instant E-Ticket Pass</span>
            </div>
        </div>
    </div>
</div>

<!-- Featured Events Showcase -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
        <div>
            <span class="text-uppercase fw-bold small text-primary" style="letter-spacing: 0.08em;">Upcoming Activities</span>
            <h2 class="fw-bold mb-0">Featured College Events</h2>
        </div>
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-purple">
            View All Events <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
            <h4 class="fw-bold text-muted">No upcoming events right now</h4>
            <p class="text-muted">Check back soon for newly published activities.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model)
            {
                var categoryBadgeClass = ev.Category.ToLower() switch
                {
                    "technical" => "badge-technical",
                    "cultural" => "badge-cultural",
                    "sports" => "badge-sports",
                    "workshop" => "badge-workshop",
                    "seminar" => "badge-seminar",
                    _ => "badge-general"
                };

                var percentFilled = ev.Capacity > 0 ? (int)Math.Min(100, Math.Round((double)ev.RegisteredCount / ev.Capacity * 100)) : 0;

                <div class="col-md-6 col-lg-4">
                    <div class="event-card">
                        <div class="event-card-img-wrapper">
                            <span class="event-card-badge @categoryBadgeClass">@ev.Category</span>
                            <img src="@ev.ImageUrl" alt="@ev.Title" class="event-card-img" onerror="this.onerror=null; this.src='/images/events/default-event.jpg';" />
                        </div>
                        <div class="event-card-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                    <i class="bi bi-calendar3 text-primary me-1"></i> @ev.EventDate.ToString("MMM dd, yyyy")
                                </span>
                                <span class="small text-muted">
                                    <i class="bi bi-clock text-primary me-1"></i> @ev.StartTime.ToString(@"hh\:mm")
                                </span>
                            </div>

                            <h5 class="event-card-title text-truncate" title="@ev.Title">@ev.Title</h5>
                            <p class="text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @ev.Description
                            </p>

                            <div class="event-meta-item">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span class="text-truncate">@ev.Venue</span>
                            </div>

                            <!-- Capacity Bar -->
                            <div class="mt-3 mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Seats: @ev.RegisteredCount / @ev.Capacity</span>
                                    <span>@(ev.RemainingCapacity) Left</span>
                                </div>
                                <div class="capacity-progress">
                                    <div class="capacity-progress-bar" style="width: @percentFilled%;"></div>
                                </div>
                            </div>

                            <div class="pt-2 border-top d-flex gap-2">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-light-lavender flex-grow-1 text-center">
                                    View Details
                                </a>
                                @if (ev.IsRegistrationOpen)
                                {
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-primary-purple flex-shrink-0">
                                        Register
                                    </a>
                                }
                                else if (ev.IsFull)
                                {
                                    <button class="btn btn-secondary rounded-pill flex-shrink-0" disabled>Full</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary rounded-pill flex-shrink-0" disabled>Closed</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- How It Works Section -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container py-3">
        <div class="text-center mb-5">
            <span class="text-uppercase fw-bold small text-primary" style="letter-spacing: 0.08em;">Seamless Process</span>
            <h2 class="fw-bold">How CampusEvents Works</h2>
            <p class="text-muted mx-auto" style="max-width: 550px;">From discovery to event day attendance, participating in campus life has never been simpler.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="stat-icon-box mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem;">
                    <i class="bi bi-search"></i>
                </div>
                <h5 class="fw-bold">1. Discover Events</h5>
                <p class="text-muted small">Filter by technical, sports, cultural festivals, or practical skill workshops happening across departments.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="stat-icon-box mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background-color: #DCFCE7; color: #166534;">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <h5 class="fw-bold">2. Quick Registration</h5>
                <p class="text-muted small">Sign in with your student account and secure your slot before capacity limits or deadlines are reached.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="stat-icon-box mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background-color: #FEF3C7; color: #92400E;">
                    <i class="bi bi-trophy"></i>
                </div>
                <h5 class="fw-bold">3. Check-In &amp; Attend</h5>
                <p class="text-muted small">Bring your student pass to the venue, get your attendance marked by administrators, and celebrate achievements.</p>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<div class="container my-5">
    <div class="card border-0 rounded-4 p-5 text-center text-white" style="background: linear-gradient(135deg, var(--dark-purple), var(--primary-purple)); box-shadow: var(--shadow-lg);">
        <h2 class="fw-bold mb-3 text-white">Ready to Shape Your College Experience?</h2>
        <p class="lead mb-4 mx-auto" style="max-width: 650px; opacity: 0.9;">
            Join hundreds of fellow students actively registering for upcoming hackathons, sports tournaments, and workshops today.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Account" asp-action="Register" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-primary">
                <i class="bi bi-person-plus-fill me-1"></i> Register Student Account
            </a>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold">
                <i class="bi bi-calendar-event me-1"></i> Browse All Events
            </a>
        </div>
    </div>
</div>
