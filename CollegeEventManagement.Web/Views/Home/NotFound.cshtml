@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 my-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 600px;">
        <div class="stat-icon-box mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2.5rem; background: var(--light-lavender); color: var(--primary-purple);">
            <i class="bi bi-question-circle-fill"></i>
        </div>
        <h1 class="display-4 fw-bold" style="color: var(--dark-purple);">404</h1>
        <h3 class="fw-bold mb-3">Page Not Found</h3>
        <p class="text-muted mb-4">
            The event or page you are looking for may have expired, been rescheduled, or is temporarily unavailable.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-purple">
                <i class="bi bi-house me-1"></i> Back to Home
            </a>
            <a asp-controller="Events" asp-action="Index" class="btn btn-primary-purple">
                <i class="bi bi-compass me-1"></i> Browse Events
            </a>
        </div>
    </div>
</div>
