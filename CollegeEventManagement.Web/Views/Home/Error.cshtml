@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 my-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 600px;">
        <div class="stat-icon-box mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2.5rem; background: #FEE2E2; color: #EF4444;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h2 class="fw-bold mb-3" style="color: var(--text-primary);">Something went wrong</h2>
        <p class="text-muted mb-4">
            An error occurred while processing your request. Please try again or return to the home page.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-purple">
            <i class="bi bi-house me-1"></i> Return Home
        </a>
    </div>
</div>
