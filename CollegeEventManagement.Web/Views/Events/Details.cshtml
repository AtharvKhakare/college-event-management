@model EventDto
@{
    ViewData["Title"] = $"{Model.Title} - Event Details";

    var categoryBadgeClass = Model.Category.ToLower() switch
    {
        "technical" => "badge-technical",
        "cultural" => "badge-cultural",
        "sports" => "badge-sports",
        "workshop" => "badge-workshop",
        "seminar" => "badge-seminar",
        _ => "badge-general"
    };

    var percentFilled = Model.Capacity > 0 ? (int)Math.Min(100, Math.Round((double)Model.RegisteredCount / Model.Capacity * 100)) : 0;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Events" asp-action="Index" class="text-decoration-none">Events</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- Poster Banner -->
    <div class="card border-0 shadow-md rounded-4 overflow-hidden mb-4 bg-white position-relative">
        <div style="height: 320px; background-color: #EBE5FA; overflow: hidden; position: relative;">
            <img src="@Model.ImageUrl" alt="@Model.Title" class="w-100 h-100" style="object-fit: cover;" onerror="this.onerror=null; this.src='/images/events/default-event.jpg';" />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 120px; background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);"></div>
            <div style="position: absolute; bottom: 20px; left: 24px; color: white;">
                <span class="badge @categoryBadgeClass px-3 py-2 rounded-pill fw-bold mb-2">@Model.Category</span>
                <h2 class="fw-bold mb-0 text-white">@Model.Title</h2>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Event Information -->
        <div class="col-lg-8">
            <!-- Event Description Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h4 class="fw-bold mb-3" style="color: var(--dark-purple);">About This Event</h4>
                <div class="text-muted" style="line-height: 1.8; font-size: 1.05rem;">
                    @Html.Raw(Model.Description.Replace("\n", "<br/>"))
                </div>

                <hr class="my-4" />

                <!-- Event Schedule & Details -->
                <h5 class="fw-bold mb-3">Schedule &amp; Information</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon-box" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Event Date</span>
                                    <strong class="text-dark">@Model.EventDate.ToString("dddd, MMMM dd, yyyy")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon-box" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Timings</span>
                                    <strong class="text-dark">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon-box" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                    <i class="bi bi-geo-alt"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Venue</span>
                                    <strong class="text-dark">@Model.Venue</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="stat-icon-box" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Organized By</span>
                                    <strong class="text-dark">@Model.OrganizerName</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guidelines and Rules -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Registration Guidelines</h5>
                <ul class="text-muted small mb-0 ps-3" style="line-height: 1.7;">
                    <li>Participants must carry their official college ID card to the venue for attendance verification.</li>
                    <li>Registrations are personal and non-transferable. Duplicate registrations are blocked by the system.</li>
                    <li>If you cannot attend, please cancel your registration at least 24 hours prior to the event date to free seats for other students.</li>
                    <li>Certificates of participation will be issued only to students with verified attendance on event day.</li>
                </ul>
            </div>
        </div>

        <!-- Sticky Registration Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-md rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
                <h5 class="fw-bold mb-3">Registration Status</h5>

                <!-- Capacity Card -->
                <div class="p-3 rounded-3 mb-3" style="background-color: var(--light-lavender); border: 1px solid var(--lavender-border);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold text-muted">Seat Capacity</span>
                        <span class="fw-bold" style="color: var(--dark-purple);">@Model.RegisteredCount / @Model.Capacity</span>
                    </div>
                    <div class="capacity-progress mb-2">
                        <div class="capacity-progress-bar" style="width: @percentFilled%;"></div>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">@(percentFilled)% Booked</span>
                        <strong class="@(Model.RemainingCapacity <= 5 ? "text-danger" : "text-success")">
                            @Model.RemainingCapacity Seats Left
                        </strong>
                    </div>
                </div>

                <!-- Deadline Notice -->
                <div class="mb-3 p-3 rounded-3 bg-light border">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-hourglass-split text-warning fs-5"></i>
                        <span class="small fw-bold">Registration Deadline</span>
                    </div>
                    <div class="small text-muted">
                        @Model.RegistrationDeadline.ToString("MMMM dd, yyyy - hh:mm tt")
                    </div>
                    @if (Model.IsDeadlinePassed)
                    {
                        <span class="badge bg-danger rounded-pill mt-2">Deadline has passed</span>
                    }
                </div>

                <!-- Registration Actions -->
                <div class="mt-3">
                    @if (Model.IsUserRegistered)
                    {
                        <div class="alert alert-success rounded-4 text-center py-3 mb-3 border-0 bg-success-subtle text-success">
                            <i class="bi bi-check-circle-fill fs-3 d-block mb-1"></i>
                            <strong>You're Registered!</strong>
                            <div class="small">Status: @Model.UserRegistrationStatus</div>
                        </div>
                        <a asp-controller="Student" asp-action="MyRegistrations" class="btn btn-outline-purple w-100 py-2">
                            <i class="bi bi-ticket-perforated me-1"></i> View My Pass
                        </a>
                    }
                    else if (Model.IsPastEvent)
                    {
                        <div class="alert alert-secondary rounded-4 text-center py-3 mb-0 border-0">
                            <i class="bi bi-calendar-x fs-3 d-block mb-1 text-muted"></i>
                            <strong>Event Concluded</strong>
                            <div class="small text-muted">This event took place in the past.</div>
                        </div>
                    }
                    else if (Model.IsDeadlinePassed)
                    {
                        <div class="alert alert-warning rounded-4 text-center py-3 mb-0 border-0">
                            <i class="bi bi-clock-history fs-3 d-block mb-1 text-warning"></i>
                            <strong>Registration Closed</strong>
                            <div class="small text-muted">The registration deadline has passed.</div>
                        </div>
                    }
                    else if (Model.IsFull)
                    {
                        <div class="alert alert-danger rounded-4 text-center py-3 mb-0 border-0">
                            <i class="bi bi-x-circle fs-3 d-block mb-1 text-danger"></i>
                            <strong>Event Fully Booked</strong>
                            <div class="small text-muted">All @Model.Capacity seats are filled.</div>
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Events" asp-action="Register" asp-route-id="@Model.EventId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary-purple w-100 py-3 shadow-sm fs-6">
                                <i class="bi bi-check2-circle me-1"></i> Register For Event
                            </button>
                        </form>
                        <p class="text-muted small text-center mt-2 mb-0">Instant seat reservation confirmed to your profile.</p>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Events", new { id = Model.EventId })" class="btn btn-primary-purple w-100 py-3 shadow-sm fs-6">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Log In to Register
                        </a>
                        <div class="text-center mt-2">
                            <span class="text-muted small">Don't have an account?</span>
                            <a asp-controller="Account" asp-action="Register" class="small text-primary fw-bold text-decoration-none">Register</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
