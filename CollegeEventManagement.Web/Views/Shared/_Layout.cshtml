@using System.Security.Claims
@using CollegeEventManagement.Core.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College Event Management</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand navbar-brand-logo" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                    <span>Campus<span style="color: var(--primary-purple);">Events</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-compass me-1"></i> Explore Events
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole(AppRoles.Student))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Student" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Student" asp-action="MyRegistrations">
                                        <i class="bi bi-ticket-perforated me-1"></i> My Tickets
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-check me-1"></i> Admin Portal
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Events">
                                        <i class="bi bi-calendar-plus me-1"></i> Manage Events
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var userFullName = User.FindFirst(ClaimTypes.Name)?.Value ?? "User";
                            var isAdmin = User.IsInRole(AppRoles.Admin);

                            <div class="dropdown">
                                <button class="btn btn-light-lavender dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi @(isAdmin ? "bi-person-badge-fill text-danger" : "bi-person-circle text-primary") fs-5"></i>
                                    <span>@userFullName</span>
                                    <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") rounded-pill">@(isAdmin ? "Admin" : "Student")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userMenuButton">
                                    @if (!isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Student" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2 text-primary"></i> Student Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Student" asp-action="MyRegistrations">
                                                <i class="bi bi-ticket-perforated me-2 text-primary"></i> My Registrations
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Student" asp-action="Profile">
                                                <i class="bi bi-person me-2 text-primary"></i> My Profile
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer me-2 text-danger"></i> Admin Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Events">
                                                <i class="bi bi-calendar-event me-2 text-danger"></i> Manage Events
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Registrations">
                                                <i class="bi bi-people me-2 text-danger"></i> Registrations & Attendance
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Reports">
                                                <i class="bi bi-file-earmark-spreadsheet me-2 text-danger"></i> CSV Reports
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-purple">
                                <i class="bi bi-box-arrow-in-right"></i> Log In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary-purple">
                                <i class="bi bi-person-plus"></i> Student Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Notification Toasts / Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4 d-flex align-items-center gap-3 py-3" role="alert">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div class="flex-grow-1 font-weight-medium">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-4 d-flex align-items-center gap-3 py-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div class="flex-grow-1 font-weight-medium">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
                        <div class="brand-icon-box" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-calendar-event-fill"></i>
                        </div>
                        <span class="fw-bold fs-5" style="color: var(--dark-purple);">Campus<span style="color: var(--primary-purple);">Events</span></span>
                    </div>
                    <p class="text-muted small mb-0">Discover. Participate. Celebrate. Your all-in-one college activity and event management platform.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3 mb-2">
                        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">Home</a>
                        <a asp-controller="Events" asp-action="Index" class="text-muted text-decoration-none small">All Events</a>
                        <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none small">Student Portal</a>
                        <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none small">Admin Portal</a>
                    </div>
                    <p class="text-muted small mb-0">&copy; @DateTime.UtcNow.Year CampusEvents System. Built with ASP.NET Core &amp; SQL Server.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap & Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
