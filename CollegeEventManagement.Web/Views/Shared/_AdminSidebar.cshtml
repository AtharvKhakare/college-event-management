@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
}

<div class="admin-sidebar shadow-sm">
    <div class="px-2 mb-3">
        <span class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em;">
            Administration
        </span>
    </div>

    <a asp-controller="Admin" asp-action="Index" class="admin-sidebar-item @(currentAction == "Index" ? "active" : "")">
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
    </a>

    <a asp-controller="Admin" asp-action="Events" class="admin-sidebar-item @(currentAction == "Events" || currentAction == "EditEvent" || currentAction == "EventDetails" ? "active" : "")">
        <i class="bi bi-calendar-event"></i>
        <span>Manage Events</span>
    </a>

    <a asp-controller="Admin" asp-action="CreateEvent" class="admin-sidebar-item @(currentAction == "CreateEvent" ? "active" : "")">
        <i class="bi bi-calendar-plus"></i>
        <span>Create Event</span>
    </a>

    <a asp-controller="Admin" asp-action="Registrations" class="admin-sidebar-item @(currentAction == "Registrations" ? "active" : "")">
        <i class="bi bi-ticket-perforated"></i>
        <span>Registrations</span>
    </a>

    <a asp-controller="Admin" asp-action="Students" class="admin-sidebar-item @(currentAction == "Students" ? "active" : "")">
        <i class="bi bi-people"></i>
        <span>Manage Students</span>
    </a>

    <a asp-controller="Admin" asp-action="Attendance" class="admin-sidebar-item @(currentAction == "Attendance" ? "active" : "")">
        <i class="bi bi-clipboard-check"></i>
        <span>Attendance</span>
    </a>

    <a asp-controller="Admin" asp-action="Reports" class="admin-sidebar-item @(currentAction == "Reports" ? "active" : "")">
        <i class="bi bi-file-earmark-spreadsheet"></i>
        <span>Reports &amp; Export</span>
    </a>

    <hr class="my-3 opacity-25" />

    <div class="px-2 mb-2">
        <span class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em;">
            Live Shortcuts
        </span>
    </div>

    <a asp-controller="Events" asp-action="Index" target="_blank" class="admin-sidebar-item text-muted">
        <i class="bi bi-box-arrow-up-right"></i>
        <span>View Public Site</span>
    </a>
</div>
