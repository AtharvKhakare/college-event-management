# Multi-stage Docker build for CollegeEventManagement.Web (.NET 10)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files for caching layer
COPY ["CollegeEventManagement.Core/CollegeEventManagement.Core.csproj", "CollegeEventManagement.Core/"]
COPY ["CollegeEventManagement.Web/CollegeEventManagement.Web.csproj", "CollegeEventManagement.Web/"]

RUN dotnet restore "CollegeEventManagement.Web/CollegeEventManagement.Web.csproj"

# Copy full source and publish
COPY . .
WORKDIR "/src/CollegeEventManagement.Web"
RUN dotnet publish "CollegeEventManagement.Web.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "CollegeEventManagement.Web.dll"]
